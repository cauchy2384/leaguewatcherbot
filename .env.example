# League Watcher Bot - Environment Variables Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to git

# Doppler Service Token (required)
# Bot loads BOT_DISCORD_TOKEN, BOT_OWNER_ID, and all config from Doppler.
# Create a Service Token in the Doppler dashboard for project leaguewatcherbot / config prd.
DOPPLER_TOKEN=dp.st.your_doppler_service_token_here

# Optional: Log level
# Options: info, debug, error
# Default: info
LOG_LEVEL=info
